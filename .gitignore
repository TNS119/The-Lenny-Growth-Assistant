# ==============================================================================
# The Lenny Growth Assistant - Comprehensive Monorepo .gitignore
# ==============================================================================

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# ── Python & Bytecode ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ── Python Virtual Environments ───────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

# ── Testing, Coverage & Linters ───────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ── Node, Next.js & Frontend ──────────────────────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.npm/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
next-env.d.ts.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.turbo/
.vercel/

# ── Database & Persistent Data Stores ─────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
pgdata/
postgres_data/
backend/data/sessions_store.json
backend/data/sessions_store*.json
backend/data/transcripts/
!backend/data/transcripts/.gitkeep

# ── Logs & Temporary Scratch Files ────────────────────────────────────────────
*.log
logs/
*.tmp
*.temp
scratch/
tmp/
temp/

# ── Media & Heavy Pitch Video Deliverables ────────────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.webm

# ── Docker & Local Verification Scripts ───────────────────────────────────────
docker-compose.override.yml
enable_docker_virtualization.bat
/scripts/

# ── IDEs & Operating System Artifacts ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── AI Agents & Local Caches ──────────────────────────────────────────────────
.agent/
.cache/
hf_cache/
torch_cache/


