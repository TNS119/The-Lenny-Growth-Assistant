# =====================================================================
# THE LENNY GROWTH ASSISTANT - ENVIRONMENT CONFIGURATION
# =====================================================================

# Database Configuration (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant

# LLM Provider Configuration
# Options: "ollama" (Default local), "claude", "openai", "groq", "gemini"
DEFAULT_LLM_PROVIDER=groq

# Local Ollama Settings (100% Free - Offline Local Inference)
# Inside Docker: http://host.docker.internal:11434
# Outside Docker: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud Providers (Optional - Supported via Multi-Cloud Layer)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Free Cloud Options (No Credit Card Required)
# Free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# RAG & Retrieval Thresholds
SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
